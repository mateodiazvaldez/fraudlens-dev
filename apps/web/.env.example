# Solo desarrollo local; Docker expone MongoDB en loopback.
MONGODB_URI=mongodb://127.0.0.1:27017/fraudlens
# En producción, reemplazar por el URI de MongoDB Atlas con el nombre de DB.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/fraudlens

# Credencial directa de TypeSafe. Nunca usar NEXT_PUBLIC_ para secretos.
TYPESAFE_AI_API_KEY=
TYPESAFE_AI_MODEL=jev-latest
